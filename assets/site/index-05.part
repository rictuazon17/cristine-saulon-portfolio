: var(--text);
      font-size: 0.95rem;
    }
    .ref-role {
      font-size: 0.8rem;
      color: var(--text-dim);
    }

    /* ================================================================
       FOOTER
       ================================================================ */
    .footer {
      padding: 2.5rem 2rem;
      text-align: center;
      border-top: 1px solid var(--border);
      color: var(--text-dim);
      font-size: 0.85rem;
    }

    /* ================================================================
       STAGGER DELAYS — Only for reveal, NOT hover
       ================================================================ */
    .stats-grid .stat-card:nth-child(1)  { transition-delay: 0s; }
    .stats-grid .stat-card:nth-child(2)  { transition-delay: calc(var(--stagger-step) * 1); }
    .stats-grid .stat-card:nth-child(3)  { transition-delay: calc(var(--stagger-step) * 2); }
    .stats-grid .stat-card:nth-child(4)  { transition-delay: calc(var(--stagger-step) * 3); }

    .exp-list .exp-item:nth-child(1)  { transition-delay: 0s; }
    .exp-list .exp-item:nth-child(2)  { transition-delay: calc(var(--stagger-step) * 1); }
    .exp-list .exp-item:nth-child(3)  { transition-delay: calc(var(--stagger-step) * 2); }
    .exp-list .exp-item:nth-child(4)  { transition-delay: calc(var(--stagger-step) * 3); }
    .exp-list .exp-item:nth-child(5)  { transition-delay: calc(var(--stagger-step) * 4); }

    .skills-grid .skill-item:nth-child(1)   { transition-delay: 0s; }
    .skills-grid .skill-item:nth-child(2)   { transition-delay: calc(var(--stagger-step) * 0.4); }
    .skills-grid .skill-item:nth-child(3)   { transition-delay: calc(var(--stagger-step) * 0.8); }
    .skills-grid .skill-item:nth-child(4)   { transition-delay: calc(var(--stagger-step) * 1.2); }
    .skills-grid .skill-item:nth-child(5)   { transition-delay: calc(var(--stagger-step) * 1.6); }
    .skills-grid .skill-item:nth-child(6)   { transition-delay: calc(var(--stagger-step) * 2.0); }
    .skills-grid .skill-item:nth-child(7)   { transition-delay: calc(var(--stagger-step) * 2.4); }
    .skills-grid .skill-item:nth-child(8)   { transition-delay: calc(var(--stagger-step) * 2.8); }
    .skills-grid .skill-item:nth-child(9)   { transition-delay: calc(var(--stagger-step) * 3.2); }
    .skills-grid .skill-item:nth-child(10)  { transition-delay: calc(var(--stagger-step) * 3.6); }
    .skills-grid .skill-item:nth-child(11)  { transition-delay: calc(var(--stagger-step) * 4.0); }
    .skills-grid .skill-item:nth-child(12)  { transition-delay: calc(var(--stagger-step) * 4.4); }
    .skills-grid .skill-item:nth-child(13)  { transition-delay: calc(var(--stagger-step) * 4.8); }
    .skills-grid .skill-item:nth-child(14)  { transition-delay: calc(var(--stagger-step) * 5.2); }
    .skills-grid .skill-item:nth-child(15)  { transition-delay: calc(var(--stagger-step) * 5.6); }

    .references-grid .ref-card:nth-child(1)  { transition-delay: 0s; }
    .references-grid .ref-card:nth-child(2)  { transition-delay: calc(var(--stagger-step) * 1); }
    .references-grid .ref-card:nth-child(3)  { transition-delay: calc(var(--stagger-step) * 2); }

    .contact-links .contact-link:nth-child(1)  { transition-delay: 0s; }
    .contact-links .contact-link:nth-child(2)  { transition-delay: calc(var(--stagger-step) * 1); }
    .contact-links .contact-link:nth-child(3)  { transition-delay: calc(var(--stagger-step) * 2); }

    /* ================================================================
       RESPONSIVE
       ================================================================ */
    @media (max-width: 900px) {
      .about-grid { grid-template-columns: 1fr; gap: 2rem; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .nav-links { display: none; }
      .nav-toggle { display: flex; }
      .exp-timeline { padding-left: 0; }
      .exp-timeline::before { display: none; }
    }
    @media (max-width: 600px) {
      .stats-grid { grid-template-columns: 1fr 1fr; gap: 0.875rem; }
      .stat-card { padding: 1.5rem 1rem; }
      .stat-number { font-size: 2.2rem; }
      .exp-item { padding: 1.25rem 1.5rem; }
      .exp-header { flex-direction: column; }
      .skills-grid { grid-template-columns: 1fr; }
      .references-grid { grid-template-columns: 1fr; }
      .hero { padding: 6rem 1.5rem 4rem; }
      .hero-photo, .hero-photo-fallback { width: 130px; height: 130px; }
      section { padding: 4rem 1.5rem; }
      .nav { padding: 1rem 1.5rem; }
      .nav.scrolled { padding: 0.75rem 1.5rem; }
      .mobile-nav { width: 260px; }
    }

    /* ================================================================
       REDUCED MOTION
       ================================================================ */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
      html { scroll-behavior: auto; }
      .hero-photo-wrap,
      .hero-badge, .hero-greeting, .hero-name, .hero-title, .hero-desc, .hero-cta, .hero-scroll,
      .reveal, .section-label, .section-title, .section-subtitle, .about-text p,
      .stat-card, .exp-item, .skill-item, .contact-link, .ref-card {
        opacity: 1 !important;
        transform: none !important;
        animation: none !important;
      }
      .hero-photo-wrap.visible .hero-photo { animation: none !important; }
      .hero-photo-wrap.visible::before { animation: none !important; opacity: 0.2 !important; }
      .hero-scroll.visible { animation: none !important; }
      .ambient-bg { display: none; }
      .exp-timeline::before { transform: scaleY(1) !important; }
    }
  </style>
</head>
