card.visible .stat-number::after {
      transform: translateX(-50%) scaleX(1);
    }
    .stat-label {
      font-size: 0.85rem;
      color: var(--text-muted);
      font-weight: 500;
      margin-top: 0.75rem;
    }

    /* ================================================================
       EXPERIENCE SECTION
       ================================================================ */
    .experience { padding: 6rem 2rem; }
    .exp-timeline {
      position: relative;
      padding-left: 2rem;
    }
    .exp-timeline::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 2px;
      background: linear-gradient(180deg, var(--accent), transparent);
      border-radius: 2px;
      transform-origin: top;
      transform: scaleY(0);
      transition: transform 1.2s cubic-bezier(0.4,0,0.2,1);
    }
    .exp-timeline.visible::before {
      transform: scaleY(1);
    }
    .exp-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .exp-item {
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.75rem 2rem;
      transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
      position: relative;
      overflow: hidden;
    }
    .exp-item.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .exp-item::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 3px;
      background: linear-gradient(180deg, var(--accent), var(--accent-light));
      border-radius: 0 2px 2px 0;
      opacity: 0;
      transition: opacity var(--transition-fast);
    }
    .exp-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 48px rgba(0,0,0,0.25), 0 0 0 1px rgba(59,130,246,0.08);
      border-color: rgba(59,130,246,0.15);
    }
    .exp-item:hover::before { opacity: 1; }
    .exp-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.875rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .exp-role {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text);
    }
    .exp-company {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--accent-light);
    }
    .exp-date {
      font-size: 0.8rem;
      color: var(--text-dim);
      font-weight: 500;
      white-space: nowrap;
    }
    .exp-details { list-style: disc; padding-left: 1.25rem; }
    .exp-details li {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-bottom: 0.4rem;
      line-height: 1.65;
    }
    .exp-details li:last-child { margin-bottom: 0; }

    /* ================================================================
       SKILLS SECTION
       ================================================================ */
    .skills {
      padding: 6rem 2rem;
      background: linear-gradient(180deg, transparent 0%, rgba(30,41,59,0.2) 50%, transparent 100%);
    }
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 0.875rem;
    }
    .skill-item {
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem 1.25rem;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 0.75rem;
      cursor: default;
      /* Hover uses its own transition, NOT the reveal transition */
      transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
    }
    .skill-item.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .skill-item::before {
      content: '';
      width: 6px; height: 6px;
      background: var(--accent);
      border-radius: 50%;
      flex-shrink: 0;
      transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    }
    .skill-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 28px rgba(0,0,0,0.2), 0 0 0 1px rgba(59,130,246,0.1);
      border-color: rgba(59,130,246,0.2);
      background: rgba(30,41,59,0.85);
    }
    .skill-item:hover::before {
      transform: scale(1.5);
      box-shadow: 0 0 10px var(--accent);
    }

    /* ================================================================
       CONTACT SECTION
       ================================================================ */
    .contact {
      padding: 6rem 2rem;
      text-align: center;
    }
    .contact .section-title { margin-bottom: 0.75rem; }
    .contact .section-subtitle { max-width: 500px; margin: 0 auto 2.5rem; }
    .contact-links {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }
    .contact-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.875rem 1.5rem;
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text);
      transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
    }
    .contact-link.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .contact-link:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 28px rgba(0,0,0,0.2);
      border-color: rgba(59,130,246,0.2);
      color: var(--accent-light);
    }
    .contact-link:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    /* ================================================================
       REFERENCES SECTION
       ================================================================ */
    .references {
      padding: 5rem 2rem;
      background: linear-gradient(180deg, transparent 0%, rgba(30,41,59,0.15) 100%);
    }
    .references-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.5rem;
    }
    .ref-card {
      background: var(--surface-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.75rem;
      transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    }
    .ref-card.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .ref-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 40px rgba(0,0,0,0.22);
    }
    .ref-quote {
      font-style: italic;
      color: var(--text-muted);
      margin-bottom: 1.25rem;
      line-height: 1.75;
      position: relative;
      padding-left: 1rem;
      border-left: 2px solid var(--accent);
    }
    .ref-author {
      font-weight: 600;
      color